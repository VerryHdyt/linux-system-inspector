#!/usr/bin/env bash
# linux-system-inspector - lightweight, read-only Linux system inspector.
set -Eeuo pipefail
IFS=$'\n\t'

readonly VERSION="0.2.0"
readonly PROG="${0##*/}"
readonly TTY=0
COLOR=0
ANIMATE=0

if [[ -t 1 && -z "${NO_COLOR:-}" && "${TERM:-dumb}" != "dumb" ]]; then
  COLOR=1
  ANIMATE=1
fi

# ANSI palette. All styling is automatically disabled for pipes and redirected output.
if (( COLOR )); then
  readonly RESET=$'\033[0m' BOLD=$'\033[1m' DIM=$'\033[2m'
  readonly CYAN=$'\033[36m' BLUE=$'\033[34m' GREEN=$'\033[32m'
  readonly YELLOW=$'\033[33m' RED=$'\033[31m' MAGENTA=$'\033[35m'
else
  readonly RESET='' BOLD='' DIM='' CYAN='' BLUE='' GREEN='' YELLOW='' RED='' MAGENTA=''
fi

die() { printf '%sError:%s %s\n' "$RED" "$RESET" "$*" >&2; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }
heading() { printf '\n%s%s== %s ==%s\n' "$BOLD" "$CYAN" "$1" "$RESET"; }

show_intro() {
  (( ANIMATE )) || return 0
  local frames=('⠋' '⠙' '⠹' '⠸' '⠼' '⠴' '⠦' '⠧' '⠇' '⠏') frame
  printf '%s' "$DIM"
  for frame in "${frames[@]:0:8}"; do
    printf '\r%s  Initializing system inspector...' "$frame"
    sleep 0.07
  done
  printf '\r%*s\r' 48 ''
  printf '%s%s╭──────────────────────────────────────────╮%s\n' "$CYAN" "$BOLD" "$RESET"
  printf '%s%s│       LINUX SYSTEM INSPECTOR v%-12s│%s\n' "$CYAN" "$BOLD" "$VERSION" "$RESET"
  printf '%s%s╰──────────────────────────────────────────╯%s\n' "$CYAN" "$BOLD" "$RESET"
  printf '%sRead-only system overview • Bash edition%s\n\n' "$DIM" "$RESET"
}

require_linux() {
  [[ -r /proc/meminfo && -r /proc/cpuinfo ]] || die "This tool requires a Linux system with readable /proc files."
}

show_cpu() {
  heading "CPU"
  if [[ -r /proc/cpuinfo ]]; then
    awk -F: '
      /^model name[[:space:]]*:/ {gsub(/^[ \t]+/, "", $2); if (!model) model=$2}
      /^processor[[:space:]]*:/ {cores++}
      END {
        printf "  Model: %s\n", model ? model : "Unavailable"
        printf "  Logical CPUs: %d\n", cores
      }' /proc/cpuinfo
  else
    printf '  CPU information unavailable (/proc/cpuinfo).\n'
  fi
  if [[ -r /proc/loadavg ]]; then
    read -r one five fifteen _ < /proc/loadavg
    printf '  Load average (1m, 5m, 15m): %s, %s, %s\n' "$one" "$five" "$fifteen"
  fi
}

show_memory() {
  heading "MEMORY"
  if [[ -r /proc/meminfo ]]; then
    awk -v green="$GREEN" -v yellow="$YELLOW" -v reset="$RESET" '
      /^MemTotal:/ {total=$2}
      /^MemAvailable:/ {available=$2}
      /^SwapTotal:/ {swap_total=$2}
      /^SwapFree:/ {swap_free=$2}
      END {
        if (total > 0) {
          used=total-available
          pct=used/total*100
          color=(pct >= 85 ? yellow : green)
          printf "  RAM total:     %.2f GiB\n", total/1048576
          printf "  RAM used:      %s%.2f GiB (%.1f%%)%s\n", color, used/1048576, pct, reset
          printf "  RAM available: %.2f GiB\n", available/1048576
          width=24; filled=int(pct/100*width)
          printf "  Usage:         ["
          for (i=0;i<width;i++) printf "%s", (i<filled ? "#" : "-")
          printf "] %.1f%%\n", pct
        } else print "  RAM information unavailable."
        if (swap_total > 0)
          printf "  Swap used:     %.2f / %.2f GiB\n", (swap_total-swap_free)/1048576, swap_total/1048576
        else print "  Swap:          not configured"
      }' /proc/meminfo
  else
    printf '  Memory information unavailable (/proc/meminfo).\n'
  fi
}

show_disk() {
  heading "FILESYSTEMS"
  if have df; then
    df -h -x tmpfs -x devtmpfs -x squashfs -x overlay 2>/dev/null || df -h
  else
    printf '  df command not found.\n'
  fi
}

show_processes() {
  heading "TOP PROCESSES"
  if have ps; then
    ps -eo pid,comm,%cpu,%mem --sort=-%cpu | head -n 11
  else
    printf '  ps command not found.\n'
  fi
}

show_network() {
  heading "NETWORK INTERFACES"
  if have ip; then
    ip -brief address 2>/dev/null || ip address
  elif have ifconfig; then
    ifconfig
  else
    printf '  Neither ip nor ifconfig is installed.\n'
  fi
}

show_host() {
  heading "HOST"
  printf '  Hostname: %s\n' "$(hostname 2>/dev/null || printf unknown)"
  if [[ -r /etc/os-release ]]; then
    # shellcheck disable=SC1091
    . /etc/os-release
    printf '  Operating system: %s\n' "${PRETTY_NAME:-Linux}"
  else
    printf '  Operating system: Linux\n'
  fi
  printf '  Kernel: %s\n' "$(uname -r 2>/dev/null || printf unknown)"
  printf '  Architecture: %s\n' "$(uname -m 2>/dev/null || printf unknown)"
  if [[ -r /proc/uptime ]]; then
    awk '{seconds=int($1); days=int(seconds/86400); hours=int((seconds%86400)/3600); minutes=int((seconds%3600)/60); printf "  Uptime: %d days, %d hours, %d minutes\n", days, hours, minutes}' /proc/uptime
  fi
}

usage() {
  cat <<EOF
$PROG v$VERSION - lightweight Linux system inspector

Usage:
  $PROG [options] [command]

Options:
  --no-anim    Disable terminal startup animation
  --plain      Disable colors and animation
  -h, --help   Show this help

Commands:
  summary      Show host, CPU, memory, disk, and network overview (default)
  host         Show host and operating-system information
  cpu          Show CPU model, logical CPUs, and load averages
  memory       Show RAM and swap usage
  disk         Show mounted filesystem usage
  processes    Show the top 10 processes by CPU usage
  network      Show network interfaces and addresses
  all          Show all inspection sections
  version      Show version

Examples:
  $PROG
  $PROG --no-anim all
  $PROG --plain memory

Animation and colors are enabled only in interactive terminals.
This tool is read-only and does not require root for normal operation.
EOF
}

main() {
  local command="summary" arg
  while (($#)); do
    arg="$1"; shift
    case "$arg" in
      --no-anim) ANIMATE=0 ;;
      --plain) COLOR=0; ANIMATE=0 ;;
      help|-h|--help) usage; return 0 ;;
      version|-v|--version) printf '%s %s\n' "$PROG" "$VERSION"; return 0 ;;
      summary|host|cpu|memory|disk|processes|network|all)
        [[ "$command" == summary ]] || die "Only one command may be supplied."
        command="$arg"
        ;;
      *) die "Unknown option or command: $arg (try '$PROG --help')" ;;
    esac
  done

  require_linux
  show_intro
  case "$command" in
    summary) show_host; show_cpu; show_memory; show_disk ;;
    host) show_host ;;
    cpu) show_cpu ;;
    memory) show_memory ;;
    disk) show_disk ;;
    processes) show_processes ;;
    network) show_network ;;
    all) show_host; show_cpu; show_memory; show_disk; show_processes; show_network ;;
  esac
}
main "$@"
